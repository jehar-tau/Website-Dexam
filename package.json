{
  "name": "dexam-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "check:site": "node scripts/check-redesign.mjs && node --test src/site/*.test.mjs && node scripts/check-growth-data.mjs",
    "check:growth": "node scripts/check-growth-data.mjs",
    "check:live": "node scripts/check-site.mjs",
    "test:browser": "playwright test",
    "test:report": "node --test src/assessment/detailed-report.test.mjs src/assessment/practice-pdf.test.mjs && playwright test --config playwright.report.config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "jszip": "^3.10.1",
    "pdf-lib": "1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.2",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
